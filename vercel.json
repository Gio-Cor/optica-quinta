{
  "version": 2,
  "builds": [
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "Backend/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Backend/src/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "Frontend/$1"
    }
  ]
}
